# syntax=docker/dockerfile:1

# =============================================================================
#  Dockerfile.model —— DeepSeek-V4-Flash-0731 专属服务镜像层
#
#  与「单镜像 + 运行时打补丁」不同：本镜像在【构建期】把该模型所需的 vLLM 补丁
#  与调优环境变量烘培进本地源码编译的 runner（基座 = 主流 vLLM v0.26.0 +
#  Anemll-式 DGX Spark 定向 overlay），运行时无需 apply-mod，
#  Fireworks 拉取该镜像即可直接发布。
#
#  模型权重（约 160GiB FP8）不打包进镜像：走 Fireworks 模型管理
#  （管理网下载 → head → RoCE 同步 → 各节点 HF 缓存挂载），镜像内离线加载。
#
#  调优变量来源：DeepSeek-V4-Flash-0731 + v0.26.0 主路径（nvfp4/fp8_ds_mla
#  KV、--moe-backend flashinfer_b12x、dspark 投机）的 GB10 推荐 env 集合。
# =============================================================================

ARG BASE_IMAGE=fireworks-models/base-vllm-b12x:0.2.0
FROM ${BASE_IMAGE}
ARG BASE_IMAGE

# 1) 烘培 vLLM 混合加载补丁
#    --load-format instanttensor 时，同 checkpoint 内的 dspark 投机草稿改走
#    lazy safetensors（避免对整份权重做第二次 InstantTensor 流式拷贝）。
#    run.sh 为纯文件级 Python 补丁：AST 校验 + 幂等，构建期安全。
#    锚点已对齐 v0.26.0 的 get_model（签名逐字节一致），--check 通过即可复用。
COPY patches/hybrid-draft-loader /opt/fw/patches/hybrid-draft-loader
RUN set -eux; \
    cd /opt/fw/patches/hybrid-draft-loader && bash run.sh; \
    rm -rf /opt/fw/patches/hybrid-draft-loader

# 1.5) 烘培 fw-warmup 补丁（NVIDIA/DGX Spark mHC warmup no-op 修复 + sparse MLA 覆盖）
#      根因（2026-08-05 长上下文 OOM）：deepseek_v4_mhc_warmup 的属性检查要求
#      hc_pre/hc_post（仅 AMD/XPU 有），NVIDIA 层没有 → 启动从不预热首层 broadcast
#      变体（mhc_pre_big_fuse_broadcast_with_norm_tilelang）→ 首个长请求推理期
#      JIT 编译 → 峰值内存 OOM。补丁让 NVIDIA 层直接调 tilelang 内核预热全部变体，
#      并把 _SPARSE_MLA_MIXED_WARMUP_TOKENS 16→8192。纯文件级 Python 补丁（AST 校验
#      + 幂等），锚点漂移时拒绝打补丁（构建失败）而非静默打坏。
COPY patches/fw-warmup /opt/fw/patches/fw-warmup
RUN set -eux; \
    cd /opt/fw/patches/fw-warmup && bash run.sh; \
    rm -rf /opt/fw/patches/fw-warmup

# 2) 烘培该模型调优环境变量（v0.26.0 主路径 / GB10 专用；配方 environment 层可覆盖）
#    注：fork 时代变量（VLLM_USE_B12X_WO_PROJECTION/_MHC/_FP8_GEMM/_SPARSE_INDEXER、
#    VLLM_USE_V2_MODEL_RUNNER、CUTE_DSL_ARCH…）在 v0.26.0 已移出。
#    MoE：默认 auto（v0.26.0 原生 DeepGemmFP4Experts——真机验证 prefill 2200+ tok/s；
#    b12x 走 --moe-backend flashinfer_b12x 时 decode 更优但 v0.26.0 集成下 prefill
#    ~88 tok/s 不可用，故不默认启用）。dspark 投机参数走配方 --speculative-config。
ENV FW_HYBRID_DRAFT_LOADER=auto \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0 \
    VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 \
    VLLM_USE_BREAKABLE_CUDAGRAPH=0 \
    VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 \
    TRITON_CACHE_DIR=/cache/vllm-cache/triton \
    TILELANG_CACHE_DIR=/cache/vllm-cache/tilelang \
    TILELANG_CLEANUP_TEMP_FILES=1 \
    HF_HUB_OFFLINE=1 \
    HF_HUB_DISABLE_XET=1 \
    VLLM_USE_FLASHINFER_SAMPLER=1 \
    VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256 \
    DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc

# 3) 模型元数据
ENV FW_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731
LABEL org.opencontainers.image.title="Fireworks DeepSeek-V4-Flash-0731" \
      org.opencontainers.image.description="Dedicated serving image for deepseek-ai/DeepSeek-V4-Flash-0731 (mainline vLLM v0.26.0 + GB10 overlay)" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      fw.model="deepseek-ai/DeepSeek-V4-Flash-0731" \
      fw.base="${BASE_IMAGE}"

# 4) JIT 编译缓存 bake（0.3.0+）——同硬件（GB10/sm_121a）上由本镜像自身生成的
#    TileLang/Triton/FlashInfer/torch.compile 产物，部署时由 run_vllm_node.sh
#    幂等灌入宿主挂载盘 /cache/vllm-cache（上线零推理期 JIT 编译，防 OOM）。
#    构建方式：先在服务节点用最终镜像 + 完整 warmup（warmup_longctx.py 32K..1M
#    全覆盖）生成缓存，收集 vllm-cache 根到 seed-cache/，再以
#    SEED_CACHE_DIR=seed-cache bash scripts/build.sh model bake 进镜像。
#    默认值 seed-cache-empty 为入库的占位空目录（保证干净 checkout 也能构建，
#    构建为无种子镜像，等价 0.2.0 行为，运行时 warmup 自举）。
ARG SEED_CACHE_DIR="seed-cache-empty"
COPY ["${SEED_CACHE_DIR}", "/opt/fw/vllm-cache-seed/"]
